# Copie este arquivo para ".env.local" (dev) e configure as mesmas chaves
# nas "Environment Variables" do projeto na Vercel (produção).

# String de conexão do banco Neon (Postgres). Pegue em neon.tech → seu
# projeto → "Connection string" (use a que tem "-pooler" no host).
DATABASE_URL="postgres://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# Segredo para assinar o cookie de sessão do admin (JWT). Gere um valor
# aleatório forte, por exemplo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"

# Segredo exigido para criar o PRIMEIRO admin via /api/auth/setup (proteção
# extra porque o site fica público na internet). Use outro valor aleatório.
SETUP_SECRET="troque-por-outro-valor-aleatorio"
